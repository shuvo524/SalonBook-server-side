# SalonBook server — copy to .env and fill in your own values.
# NEVER commit a real .env file to GitHub.

# Server
PORT=5000
NODE_ENV=development
# Public URL of this server (used by Better Auth). In production this is the
# deployed server URL, e.g. https://salonbook-server.onrender.com
BETTER_AUTH_URL=http://localhost:5000
# Client origin(s), comma-separated if more than one.
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string (include the database name, e.g. /salonbook)
MONGODB_URI=

# Better Auth secret — a long random string (min 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# JWT secret for API access tokens — a DIFFERENT long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (optional for local dev; required for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB API key (api.imgbb.com)
IMGBB_API_KEY=

# Set to true in production when the client and server are on different
# domains, so the Better Auth session cookie works cross-site.
COOKIE_CROSS_SITE=false
